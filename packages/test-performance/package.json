{
  "name": "@json2csv/test-performance",
  "version": "7.0.7",
  "description": "Performance tests for json2csv",
  "keywords": [
    "json",
    "to",
    "csv",
    "export",
    "convert",
    "parse"
  ],
  "homepage": "https://juanjodiaz.github.io/json2csv",
  "bugs": {
    "url": "https://github.com/juanjoDiaz/json2csv/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juanjoDiaz/json2csv.git"
  },
  "license": "MIT",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build:dependencies": "npm run build -w @json2csv/formatters -w @json2csv/transforms -w @json2csv/plainjs",
    "prebenchmark": "npm run build:dependencies",
    "benchmark": "node benchmarks/index.js",
    "flamegraph": "0x --output-dir flamegraphs/results --open flamegraphs/flamegraph.js",
    "lint": "biome check .",
    "pretest": "npm run build:dependencies",
    "test": "node benchmarks/index.js --validate-only"
  },
  "devDependencies": {
    "0x": "^6.0.0",
    "benchmark": "^2.1.4"
  }
}
