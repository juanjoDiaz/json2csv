{
  "name": "@json2csv/test-performance",
  "version": "7.0.8",
  "description": "Performance tests for json2csv",
  "keywords": [
    "json",
    "to",
    "csv",
    "export",
    "convert",
    "parse"
  ],
  "homepage": "https://juanjodiaz.github.io/json2csv",
  "bugs": {
    "url": "https://github.com/juanjoDiaz/json2csv/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juanjoDiaz/json2csv.git"
  },
  "license": "MIT",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build:dependencies": "npm run build -w @json2csv/formatters -w @json2csv/transforms -w @json2csv/plainjs",
    "lint": "biome check .",
    "pretest:node": "npm run build:dependencies",
    "test:node": "node benchmarks/index.js --validate-only",
    "pretest:browser": "npm run build:dependencies",
    "test:browser": "node benchmarks/browser.js --validate-only",
    "pretest:all": "npm run build:dependencies",
    "test:all": "node benchmarks/all.js --validate-only",
    "prebenchmark:node": "npm run build:dependencies",
    "benchmark:node": "node benchmarks/index.js",
    "prebenchmark:browser": "npm run build:dependencies",
    "benchmark:browser": "node benchmarks/browser.js",
    "prebenchmark:all": "npm run build:dependencies",
    "benchmark:all": "node benchmarks/all.js",
    "flamegraph": "0x --output-dir flamegraphs/results --open flamegraphs/flamegraph.js"
  },
  "devDependencies": {
    "0x": "^6.0.0",
    "benchmark": "^2.1.4",
    "playwright": "^1.62.1"
  }
}
